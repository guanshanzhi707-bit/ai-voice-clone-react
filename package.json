{
  "name": "ai-voice-clone-react",
  "version": "1.0.0",
  "description": "AI语音复刻应用 - React版本",
  "private": true,
  "main": "server.js",
  "homepage": "https://guanshanzhi707-bit.github.io/ai-voice-clone-react",
  "scripts": {
    "start": "react-scripts start",
    "start:public": "HOST=0.0.0.0 react-scripts start",
    "build": "react-scripts build",
    "build:gh": "npm run build && cp build/index.html build/404.html",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server": "node server.js",
    "server:dev": "nodemon server.js",
    "dev": "concurrently \"npm run server\" \"npm run start\"",
    "dev:public": "concurrently \"npm run server\" \"npm run start:public\"",
    "predeploy": "npm run build:gh",
    "deploy": "gh-pages -d build"
  },
  "keywords": [
    "ai",
    "voice",
    "clone",
    "tts",
    "doubao",
    "react",
    "typescript"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/react-router-dom": "^5.3.3",
    "@types/styled-components": "^5.1.29",
    "axios": "^1.6.2",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.17.0",
    "react-scripts": "5.0.1",
    "styled-components": "^6.1.1",
    "typescript": "^4.9.5",
    "uuid": "^9.0.1",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@types/multer": "^1.4.11",
    "gh-pages": "^6.3.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
